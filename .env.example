# AutoSphere Supabase Configuration
# Obtain your Project URL and Anon/Public Key from your Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Security Notice:
# NEVER place SUPABASE_SERVICE_ROLE_KEY in frontend .env files!
# Only the public 'anon' key is safe for client applications with Row Level Security (RLS).

# Server-Side Gemini AI Configuration (Netlify Functions / Vite Dev Middleware)
# NEVER prefix with VITE_ to prevent leaking the secret key into the client bundle!
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: gemini-1.5-flash (default) or gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
